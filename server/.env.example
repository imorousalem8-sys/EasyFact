# ============================================================
# EASYFACT AFRICA — Variables d'Environnement (Exemple)
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS COMMITTER .env dans Git !
# ============================================================

# Application
PORT=3000
NODE_ENV=development
APP_BASE_URL=https://easy-fact.vercel.app

# Sécurité JWT
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_chars

# Rate Limiting Anti Brute-Force
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=5

# ============================================================
# SUPABASE POSTGRESQL — https://supabase.com
# ============================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# ============================================================
# RESEND EMAIL SERVICE — https://resend.com (gratuit: 3000/mois)
# ============================================================
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=EasyFact Africa

# ============================================================
# WAVE PAYMENT — https://wave.com/fr-sn/business/
# ============================================================
WAVE_API_KEY=wave_sec_live_your_wave_api_key_here
WAVE_MERCHANT_ID=your_wave_merchant_id_here

# ============================================================
# ORANGE MONEY — https://developer.orange.com
# ============================================================
ORANGE_MONEY_SECRET=your_orange_money_secret_here
ORANGE_MONEY_MERCHANT_KEY=your_om_merchant_key_here

# ============================================================
# MTN MOMO — https://momodeveloper.mtn.com (API REST gratuite)
# ============================================================
MTN_MOMO_API_KEY=your_mtn_momo_api_key_here
MTN_MOMO_API_USER=your_mtn_api_user_uuid_here
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_subscription_key_here
MTN_MOMO_ENVIRONMENT=sandbox
